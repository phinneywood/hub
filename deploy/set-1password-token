#!/bin/zsh
# Owner-run in Termius. Stores Hub's 1Password service-account token in the macOS Keychain
# (the one owner-approved exception, 2026-11-09) and checks that 1Password answers with it.
# The token is typed at a hidden prompt, reaches `security` over a pipe and `op` only through its
# own environment, and is never printed. The model key itself stays in 1Password.
REF=${HUB_OPENROUTER_REF:-op://Hub/OpenRouter/credential}
OP=${HUB_OP_PATH:-$HOME/.local/bin/op}
printf "Paste the service account token (nothing will be shown), then press Return: "
read -rs TOKEN
echo
TOKEN=${TOKEN//[[:space:]]/}
if [ -z "$TOKEN" ]; then
  echo "Nothing was entered. Nothing was saved."
  exit 1
fi
if ! env -i HOME="$HOME" PATH=/usr/bin:/bin OP_SERVICE_ACCOUNT_TOKEN="$TOKEN" "$OP" read --no-newline "$REF" >/dev/null 2>&1; then
  unset TOKEN
  echo "1Password didn't return the key at $REF with that token. Nothing was saved."
  echo "Check the vault and item names, and that the service account can read that vault."
  exit 1
fi
printf 'add-generic-password -U -s hub-1password-token -a hub -T /usr/bin/security -w %s\n' "$TOKEN" | security -i
unset TOKEN
if security find-generic-password -s hub-1password-token -a hub >/dev/null 2>&1; then
  echo "Saved. 1Password answered with the key. Hub will use it within 5 minutes."
else
  echo "Not saved. If you saw 'User interaction is not allowed', run: security unlock-keychain"
  exit 1
fi
