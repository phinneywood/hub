#!/usr/bin/env python3
"""Store Hub's separate Home Assistant read-only API token in owner-only storage."""
import getpass
import os
import stat
import sys
from pathlib import Path


def main():
    destination = Path(os.environ.get(
        "HUB_NETWORK_HA_TOKEN_FILE",
        Path.home() / "Library" / "Application Support" / "Hub" / "network-ha-token"))
    parent = destination.parent
    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    parent_info = parent.lstat()
    if (stat.S_ISLNK(parent_info.st_mode) or not stat.S_ISDIR(parent_info.st_mode)
            or parent_info.st_uid != os.getuid() or parent_info.st_mode & 0o077):
        raise RuntimeError("The Hub credential directory must be a private, owner-only directory.")
    if destination.exists() or destination.is_symlink():
        info = destination.lstat()
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != os.getuid() or info.st_mode & 0o077):
            raise RuntimeError("The existing token file is not a safe owner-only regular file.")
        if input("A Hub Home Assistant token is already stored. Replace it? [y/N] ").strip().lower() != "y":
            print("No change made.")
            return
    token = getpass.getpass("Home Assistant long-lived access token (hidden): ").strip()
    if not 32 <= len(token) <= 8192 or any(ch.isspace() for ch in token):
        raise RuntimeError("The token format or length is invalid; no file was changed.")
    temp = parent / (".network-ha-token-" + str(os.getpid()))
    try:
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(token + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, destination)
    except Exception:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass
        raise
    print("Home Assistant token stored privately for Hub. Its value was not displayed.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1)
