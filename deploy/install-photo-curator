#!/bin/sh
# Owner-run: install the photo curator (deploy/photo_curator.py) and schedule it. Usage:
#   PYTHON=/path/to/python3.12 deploy/install-photo-curator [--catch-up YYYY-MM-DD]
# PYTHON is any Python 3.10 or newer, such as the one Hub's releases are built on.
# The curator gets its own copy of Python, signed under its own name, so the Full Disk Access it needs to read
# the Photos library is given to it alone, never to Hub. It installs osxphotos (pinned) from PyPI.
# Two services, labelled with the private prefix as in install-morning-brief:
#   <prefix>.photo-curator         chooses last month's photos on the 1st at 5 am
#   <prefix>.photo-curator-apply   acts on marks made in Hub, when Hub writes them
# --catch-up chooses every month from that day to last month, once, now, through the scheduled service (so it runs
# with the service's own access, even when this script is run over SSH).
# Remove with: launchctl bootout gui/$(id -u)/<prefix>.photo-curator (and -apply)
set -eu
OSXPHOTOS=0.78.1
here=$(cd "$(dirname "$0")" && pwd)
[ -n "${PYTHON:-}" ] || { echo "set PYTHON to a Python 3.10 or newer" >&2; exit 2; }
prefix=${HUB_LABEL_PREFIX:-$(cat "$HOME/Library/Application Support/Hub/label-prefix" 2>/dev/null || echo local)}
dir="$HOME/Library/Application Support/PhotoCurator"
mkdir -p "$dir/logs"; chmod 700 "$dir"
cp "$here/photo_curator.py" "$dir/"
if [ ! -x "$dir/venv/bin/python3" ]; then
  "$PYTHON" -m venv --copies "$dir/venv"
fi
for py in "$dir"/venv/bin/python3*; do
  [ -L "$py" ] || codesign -s - -f -i "$prefix.photo-curator" "$py"
done
"$dir/venv/bin/python3" -m pip install -q "osxphotos==$OSXPHOTOS"
/usr/bin/python3 - "$dir" "$prefix" <<'PY'
import os, plistlib, sys
d, prefix = sys.argv[1:]
run = [d + '/venv/bin/python3', '-B', d + '/photo_curator.py']
for name, do, when in (('photo-curator', 'scan', {'StartCalendarInterval': {'Day': 1, 'Hour': 5, 'Minute': 0}}),
                       ('photo-curator-apply', 'apply', {'WatchPaths': [d + '/marks.json'], 'ThrottleInterval': 30})):
    label = prefix + '.' + name
    plist = os.path.expanduser('~/Library/LaunchAgents/' + label + '.plist')
    plistlib.dump({'Label': label, 'ProgramArguments': run + [do], **when,
                   'ProcessType': 'Background', 'LimitLoadToSessionType': 'Aqua',
                   'StandardOutPath': d + '/logs/' + do + '.log', 'StandardErrorPath': d + '/logs/' + do + '.err'},
                  open(plist, 'wb'))
    os.chmod(plist, 0o600)
PY
for name in photo-curator photo-curator-apply; do
  launchctl bootout "gui/$(id -u)/$prefix.$name" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$prefix.$name.plist"
done
echo "Installed. Give Full Disk Access to: $dir/venv/bin/python3"
if [ "${1:-}" = "--catch-up" ]; then
  echo "${2:?--catch-up needs a date, YYYY-MM-DD}" > "$dir/catch-up"
  launchctl kickstart "gui/$(id -u)/$prefix.photo-curator"
  echo "Catching up from $2 now; see $dir/logs/scan.log"
fi
